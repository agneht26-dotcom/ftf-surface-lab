#version 450
layout(local_size_x=8,local_size_y=8) in;

layout(set=0,binding=0) uniform sampler2D currentColor;
layout(set=0,binding=1) uniform sampler2D currentDepth;
layout(set=0,binding=2) uniform sampler2D historyColor;
layout(set=0,binding=3,rgba8) uniform writeonly image2D outColor;

layout(push_constant) uniform TaaPush {
    mat4 invCurrVP;
    mat4 prevVP;
    vec4 originDelta; // xy: currOrigin - prevOrigin, z: reset (>0.5 resets), w: alpha
    vec4 sizeInfo;    // xy: width, height, zw: jitterUv
    vec4 extra;       // x: sharpness (0..1)
} pc;

vec3 rgbToYCoCg(vec3 c){
    float y  =  0.25*c.r + 0.5*c.g + 0.25*c.b;
    float co =  0.5 *c.r           - 0.5 *c.b;
    float cg = -0.25*c.r + 0.5*c.g - 0.25*c.b;
    return vec3(y, co, cg);
}

vec3 yCoCgToRgb(vec3 ycc){
    float y=ycc.x, co=ycc.y, cg=ycc.z;
    return clamp(vec3(y + co - cg, y + cg, y - co - cg), vec3(0.0), vec3(1.0));
}

void main(){
    ivec2 dim = ivec2(pc.sizeInfo.xy);
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if(px.x >= dim.x || px.y >= dim.y) return;

    vec2 invDim = 1.0 / pc.sizeInfo.xy;
    vec2 uv = (vec2(px) + 0.5) * invDim;
    vec2 unjitterUv = clamp(uv + pc.sizeInfo.zw, vec2(0.0), vec2(1.0));
    vec3 curr = texture(currentColor, unjitterUv).rgb;

    if(pc.originDelta.z > 0.5){
        imageStore(outColor, px, vec4(curr, 1.0));
        return;
    }

    vec3 m1 = vec3(0.0);
    vec3 m2 = vec3(0.0);
    vec3 cMin = vec3(1e9);
    vec3 cMax = vec3(-1e9);
    for(int dy = -1; dy <= 1; ++dy){
        for(int dx = -1; dx <= 1; ++dx){
            vec2 qUv = clamp(unjitterUv + vec2(dx, dy) * invDim, vec2(0.0), vec2(1.0));
            vec3 ycc = rgbToYCoCg(texture(currentColor, qUv).rgb);
            m1 += ycc;
            m2 += ycc * ycc;
            cMin = min(cMin, ycc);
            cMax = max(cMax, ycc);
        }
    }
    vec3 mu = m1 / 9.0;
    vec3 sigma = sqrt(max(m2 / 9.0 - mu * mu, vec3(0.0)));
    vec3 boxMin = max(cMin, mu - 1.75 * sigma);
    vec3 boxMax = min(cMax, mu + 1.75 * sigma);

    float depth = texelFetch(currentDepth, px, 0).r;
    vec4 ndc = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 world = pc.invCurrVP * ndc;
    world /= max(abs(world.w), 1e-6) * (world.w < 0.0 ? -1.0 : 1.0);
    world.xz += pc.originDelta.xy;

    vec4 prevClip = pc.prevVP * world;
    vec2 prevUv = (prevClip.xy / max(abs(prevClip.w), 1e-6)) * 0.5 + 0.5;
    if(prevClip.w <= 0.0 || any(lessThan(prevUv, vec2(0.0))) || any(greaterThan(prevUv, vec2(1.0)))){
        imageStore(outColor, px, vec4(curr, 1.0));
        return;
    }

    vec3 histYcc = rgbToYCoCg(texture(historyColor, prevUv).rgb);
    vec3 clamped = yCoCgToRgb(clamp(histYcc, boxMin, boxMax));
    vec3 result = mix(clamped, curr, pc.originDelta.w);
    float sharp = clamp(pc.extra.x, 0.0, 1.0);
    if(sharp > 0.001){
        vec3 n = texture(currentColor, clamp(unjitterUv + vec2(0.0, -invDim.y), vec2(0.0), vec2(1.0))).rgb;
        vec3 s = texture(currentColor, clamp(unjitterUv + vec2(0.0,  invDim.y), vec2(0.0), vec2(1.0))).rgb;
        vec3 e = texture(currentColor, clamp(unjitterUv + vec2( invDim.x, 0.0), vec2(0.0), vec2(1.0))).rgb;
        vec3 w = texture(currentColor, clamp(unjitterUv + vec2(-invDim.x, 0.0), vec2(0.0), vec2(1.0))).rgb;
        vec3 blur = (n + s + e + w) * 0.25;
        result = clamp(result + (curr - blur) * (sharp * 1.15), vec3(0.0), vec3(1.0));
    }
    imageStore(outColor, px, vec4(result, 1.0));
}

