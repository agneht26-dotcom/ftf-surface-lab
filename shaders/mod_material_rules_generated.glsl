// Source rule program is generated by tools/prepare_mod_surface_rules.py.
// Bounded scalar interpreter avoids duplicating thousands of noise branches.
float modCondition(uint program,uint instruction,uint count,inout uvec4 valid,inout float noiseValues[128]){
    float stack[32];int sp=0;
    uint start=program+table.words[program+3u]+instruction*4u;
    for(uint pc=0u;pc<count;++pc){uint at=start+pc*4u;uint op=table.words[at],a=table.words[at+1u],b=table.words[at+2u],c=table.words[at+3u];
        if(op==1u){stack[sp++]=uintBitsToFloat(a);continue;}
        if(op==2u){float v=a==0u?matHeight:a==1u?matWater:a==2u?matTemperature:a==3u?matDepth:a==4u?matBlockSlope:a==5u?(matSteep?1.0:0.0):a==6u?graph.worldLevels.y:graph.surfaceOptions.y;stack[sp++]=v;continue;}
        if(op==16u){uint group=a/32u,bit=1u<<(a%32u);uint flags=valid[group];if((flags&bit)==0u){noiseValues[a]=(materialPerlin(matWorld,graph.surfaceMeta.z+b,int(c))*2.0-1.0)*1.5;valid[group]=flags|bit;}stack[sp++]=noiseValues[a];continue;}
        if(op==17u){stack[sp++]=materialWhite(matWorld,a);continue;}
        if(op==12u){stack[sp-1]=stack[sp-1]==0.0?1.0:0.0;continue;}
        if(op==15u){stack[sp-1]=-stack[sp-1];continue;}
        float y=stack[--sp],x=stack[sp-1];
        stack[sp-1]=op==3u?x+y:op==4u?x-y:op==5u?x*y:op==6u?x/y:op==7u?max(x,y):op==8u?(x>=y?1.0:0.0):op==9u?(x<=y?1.0:0.0):op==10u?(x<y?1.0:0.0):op==11u?(x>y?1.0:0.0):op==13u?(x!=0.0&&y!=0.0?1.0:0.0):(x!=0.0||y!=0.0?1.0:0.0);
    }return stack[0];
}
uint moddedSurface(uint biome,uint fallback){
    uint base=materialTableBase(),program=table.words[base+5u];if(program==0u||table.words[program]!=0x53555232u||biome>=table.words[program+1u])return fallback;
    uint first=table.words[program+4u+biome*2u],count=table.words[program+5u+biome*2u];uvec4 valid=uvec4(0);float noises[128];
    for(uint i=0u;i<count;++i){uint at=program+table.words[program+2u]+(first+i)*4u;
        if(modCondition(program,table.words[at],table.words[at+1u],valid,noises)!=0.0){uint block=table.words[at+2u];return block==0xfffffffeu?materialBandlands():block;}}
    return fallback;
}
