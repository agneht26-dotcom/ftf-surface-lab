layout(push_constant) uniform Params {uvec4 meta;vec4 domain;vec4 land;vec4 detail;vec4 climate;uvec4 seeds0;uvec4 seeds1;vec4 ftfScales;} p;
void main(){uvec2 q=gl_GlobalInvocationID.xy;uint n=p.meta.x;if(any(greaterThanEqual(q,uvec2(n))))return;precise vec2 fraction=vec2(dvec2(q)/double(n-1)),world=(fraction-.5)*p.domain.x+p.domain.yz;vec4 field=imageLoad(rawField,ivec2(q));float height=worldDiv(field.x,graph.worldLevels.w);ftfRivers(world,q.y*n+q.x,height);field.x=height*graph.worldLevels.w;imageStore(rawField,ivec2(q),field);float local=cells[q.y*n+q.x].waterHeight;if(local>0.0&&field.x<max(p.land.z,local*graph.worldLevels.w+1.0)){vec4 color=imageLoad(colors,ivec2(q));color.rgb=vec3(.12,.32,.39);imageStore(colors,ivec2(q),color);}}
