    return k==0?f-s*(f-r):dk*ln2Hi-((s*(f-r)-dk*ln2Lo)-f);
}
// Entry: weight double (lo, hi), id byte length, id word offset (4 bytes per word, little endian).
uint regionIdByte(uint entry,uint i){return (table.words[table.words[entry+3u]+(i>>2u)]>>((i&3u)*8u))&255u;}
bool regionIdLess(uint a,uint b){uint la=table.words[a+2u],lb=table.words[b+2u];for(uint i=0u;i<min(la,lb);++i){uint x=regionIdByte(a,i),y=regionIdByte(b,i);if(x!=y)return x<y;}return la<lb;}
// Candidates: count entries at list (4 words each); with members!=0xffffffff, candidate k is entry table.words[members+k].
uint regionRendezvous(uint64_t salt,ivec2 cell,uint list,uint count,uint members){
    if(count==1u)return members==0xffffffffu?0u:table.words[members];
    uint64_t mz=regionMix(uint64_t(int64_t(cell.y))),hash=regionMix(salt^regionMix(uint64_t(int64_t(cell.x)))^((mz<<29)|(mz>>35)));   // coordinateHash
    double unit=packDouble2x32(uvec2(0x00000000u,0x3ca00000u));   // (double)1.110223E-16f, which is 2^-53
    uint best=0xffffffffu;double bestScore=0.0LF;
    for(uint k=0u;k<count;++k){
        uint index=members==0xffffffffu?k:table.words[members+k],entry=list+index*4u;uint64_t h=hash;
        for(uint i=0u;i<table.words[entry+2u];++i)h=regionMix(h^uint64_t(regionIdByte(entry,i)));
        precise double u=(double(h>>11)+1.0LF)*unit,score=-fdlibmLog(u)/packDouble2x32(uvec2(table.words[entry],table.words[entry+1u]));
        if(best==0xffffffffu||score<bestScore||(score==bestScore&&regionIdLess(entry,list+best*4u))){best=index;bestScore=score;}
    }
    return best;
}
bool regionCriteria(uint at,int query[7],uint region){   // the replacement layer ParameterCriteria: region (0xffffffff: any) + inclusive quantized ranges
    if(table.words[at+1u]!=0xffffffffu&&table.words[at+1u]!=region)return false;
    for(uint a=0u;a<6u;++a)if(query[a]<int(table.words[at+2u+a*2u])||query[a]>int(table.words[at+3u+a*2u]))return false;
    return true;
}
uint regionDebug[10];   // material debug 92-101: provider, the replacement layer region, biome after the river role, final biome, target 0-5
// FTF order (WorldgenBiomeSelection + SelectionDecoration stages sorted by order): the the weighted region provider provider of the cell's
// region (WeightedRendezvous) picks from its list; stage 0, FTF's policy (TerrainBiomeRoleSelection): a river cell picks again
// from that provider's #minecraft:is_river surface entries; stage 200, the replacement layer: a region per (biome, cell)
// (CellRendezvous), then force placements, then the first partial replacement (priority, then id) whose targets hold the biome.
uint modBiome(uint biome,int query[7],bool river,ivec2 cell){
 uint mask=graph.surfaceMeta.w>>1u,footer=uint(table.words.length())-8u,provider=0u;bool mods=mask!=0u&&table.words[footer]==0x4654464du;
 uint rg=mods?table.words[footer+5u]:0u;if(rg==0u||rg+11u>footer||table.words[rg]!=0x52474E53u)rg=0xffffffffu;
 regionDebug=uint[10](0xffffffu,0xffffffu,0u,0u,uint(query[0]),uint(query[1]),uint(query[2]),uint(query[3]),uint(query[4]),uint(query[5]));
 if(mods&&(mask&1u)!=0u){biome=biomeSearch(table.words[footer+1u],query);provider=1u;}
 if(mods&&(mask&2u)!=0u&&rg!=0xffffffffu){   // minecraft:overworld (vanilla, or the the first biome pack list when the first biome pack is on: unverified) or a BOP region
  uint k=regionRendezvous(uint64_t(graph.regionSalts.x)|(uint64_t(graph.regionSalts.y)<<32),cell,table.words[rg+3u],table.words[rg+2u],0xffffffffu);
  regionDebug[0]=k;if(k>0u){biome=biomeSearch(table.words[footer+1u+k],query);provider=1u+k;}
 }
 if(river){uint root=riverRoot(provider);if(root!=0xffffffffu)biome=biomeSearch(root,query);}
 regionDebug[2]=biome;
 if(mods&&(mask&4u)!=0u&&rg!=0xffffffffu){
  uint key=canonicalBiome(biome),region=0xfffffffeu;   // noRegion: matches only criteria without a region
  if(key<table.words[1]){uint members=table.words[table.words[rg+6u]+key];
   if(members!=0u)region=regionRendezvous(uint64_t(graph.regionSalts.z)|(uint64_t(graph.regionSalts.w)<<32),cell,table.words[rg+5u],table.words[members],members+1u);}
  regionDebug[1]=region&0xffffffu;
  bool forced=false;
  for(uint i=0u;i<table.words[rg+7u];++i){uint at=table.words[rg+8u]+i*14u;if(regionCriteria(at,query,region)){biome=table.words[at];forced=true;break;}}
  if(!forced)for(uint i=0u;i<table.words[rg+9u];++i){uint at=table.words[rg+10u]+i*16u;bool target=false;
   for(uint t=0u;t<table.words[at+14u];++t)if(table.words[table.words[at+15u]+t]==key){target=true;break;}
   if(target&&regionCriteria(at,query,region)){biome=table.words[at];break;}}
 }
