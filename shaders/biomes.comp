}
vec3 unpackRgb(uint rgb){return vec3((rgb>>16u)&255u,(rgb>>8u)&255u,rgb&255u)/255.0;}
uint biomePerm(int value){return table.words[table.words[5]+(uint(value)&255u)];}
const dvec2 BIOME_GRADIENTS[12]=dvec2[12](dvec2(1,1),dvec2(-1,1),dvec2(1,-1),dvec2(-1,-1),dvec2(1,0),dvec2(-1,0),dvec2(1,0),dvec2(-1,0),dvec2(0,1),dvec2(0,-1),dvec2(0,1),dvec2(0,-1));
double biomeCorner(uint gradient,dvec2 p){precise double t=.5LF-p.x*p.x-p.y*p.y;if(t<0.0LF)return 0.0LF;t*=t;precise double v=BIOME_GRADIENTS[gradient].x*p.x+BIOME_GRADIENTS[gradient].y*p.y;return t*t*v;}
double biomeInfoNoise(dvec2 p){
    precise double s=(p.x+p.y)*.3660254037844386LF;ivec2 cell=ivec2(floor(p+dvec2(s)));precise double t=double(cell.x+cell.y)*.21132486540518713LF;
    precise dvec2 a=p-(dvec2(cell)-dvec2(t));ivec2 step=a.x>a.y?ivec2(1,0):ivec2(0,1);precise dvec2 b=a-dvec2(step)+.21132486540518713LF,c=a-1.0LF+.42264973081037427LF;
    uint ga=biomePerm(cell.x+int(biomePerm(cell.y)))%12u,gb=biomePerm(cell.x+step.x+int(biomePerm(cell.y+step.y)))%12u,gc=biomePerm(cell.x+1+int(biomePerm(cell.y+1)))%12u;
    return 70.0LF*(biomeCorner(ga,a)+biomeCorner(gb,b)+biomeCorner(gc,c));
}
#include "materials.glsl"
uint regionDebugValue(int k,uint index){ivec2 c=regionCellUnpack(regionCells[index],p.domain.yz);return (k==-2?uint(c.x):k==-1?uint(c.y):regionDebug[k])&0xffffffu;}   // 90/91 cell x/z, 92-101 regionDebug
void main(){
    if(INSPECTION&&inspection.request.w==2u){   // biome count: mark every canonical biome present in the grid
        uvec2 q=gl_GlobalInvocationID.xy;uint n=p.meta.x;if(any(greaterThanEqual(q,uvec2(n))))return;
        uint b=canonicalBiome(cells[q.y*n+q.x].biome);if(b<1024u)atomicOr(inspection.seen[b>>5u],1u<<(b&31u));
        return;
    }
    if(CORNERS){   // one invocation per 16-block corner: the preliminary level from the sample nearest to it, as the block pass would
        if(!cornerUse())return;ivec2 k=ivec2(gl_GlobalInvocationID.xy);int b=cornerBound();if(any(greaterThanEqual(k,ivec2(b))))return;
        ivec2 corner=(cornerOrigin()+k)<<4;uint n=p.meta.x;matStep=float(n-1u)/p.domain.x;
        ivec2 s=clamp(ivec2(round((vec2(corner)-(p.domain.yz-p.domain.x*.5))*matStep)),ivec2(0),ivec2(int(n)-1));
        precise vec2 fraction=vec2(dvec2(s)/double(n-1)),world=(fraction-.5)*p.domain.x+p.domain.yz;matPoint=vec2(s);matSample=world;
        corners.levels[k.y*b+k.x]=materialPreliminary(corner);return;
    }
    if(INSPECTION&&any(notEqual(gl_GlobalInvocationID,uvec3(0))))return;
    // domain.w: the first row of a progressive build's band (0 otherwise).
    uvec2 q=INSPECTION?inspection.request.xy:gl_GlobalInvocationID.xy+uvec2(0u,uint(p.domain.w));uint n=p.meta.x;if(any(greaterThanEqual(q,uvec2(n))))return;uint index=q.y*n+q.x;
    precise vec2 fraction=vec2(dvec2(q)/double(n-1)),world=(fraction-.5)*p.domain.x+p.domain.yz;vec4 field=imageLoad(rawField,ivec2(q));
    float continentalness=biomeContinentalness(world,field,index);int target[7];target[0]=int((field.z*2.0-1.0)*10000.0);target[1]=int((field.w*2.0-1.0)*10000.0);target[2]=int(continentalness*10000.0);target[3]=int(cells[index].erosion*10000.0);target[4]=0;target[5]=int(cells[index].weirdness*10000.0);target[6]=0;
    bool regionKey=graph.surfaceOptions.w>=92.0&&graph.surfaceOptions.w<=103.0;   // material debug 90-101 needs modBiome's values in a recolour pass too
    uint biome=RECOLOR_ONLY&&!regionKey?cells[index].biome:modBiome(biomeSearch(table.words[2],target),target,(cells[index].terrain&255u)==10u,regionCellUnpack(regionCells[index],p.domain.yz));if(graph.biomeOptions.z>0.0)biome=uint(graph.biomeOptions.z)-1u;if(!INSPECTION)cells[index].biome=biome;
    uint offset=table.words[4]+biome*4u,mode=graph.biomeSeeds2.w;vec3 color=unpackRgb(table.words[offset+min(mode,2u)]);
    if(mode==1u&&swampBiome(biome))color=unpackRgb(biomeInfoNoise(dvec2(world)*.0225LF)<-.1LF?5011004u:6975545u);
    float localWater=graph.worldLevels.z;if(cells[index].waterHeight>0.0)localWater=max(localWater,cells[index].waterHeight*graph.worldLevels.w+1.0);
    if(INSPECTION){uint block=materialAt(world,field,index,biome,localWater);inspection.values=vec4(field.x,field.z,field.w,localWater);inspection.ids=uvec4(biome,cells[index].terrain&255u,block,uint(round(imageLoad(colors,ivec2(q)).a*255.0)));inspection.extra=vec4(world,cells[index].erosion,cells[index].weirdness);return;}
    if(mode>0u&&mode<3u&&field.x<localWater)color=unpackRgb(table.words[offset+3u]);
    if(mode==3u){uint block=materialAt(world,field,index,biome,localWater);color=graph.surfaceOptions.w>1.5?unpackRgb(int(graph.surfaceOptions.w)-2>=90&&int(graph.surfaceOptions.w)-2<=101?regionDebugValue(int(graph.surfaceOptions.w)-94,index):materialDebug(int(graph.surfaceOptions.w)-2)):graph.surfaceOptions.w>0.0?unpackRgb(block):materialColor(block,biome,world);}
    imageStore(colors,ivec2(q),vec4(color,imageLoad(colors,ivec2(q)).a));
}
